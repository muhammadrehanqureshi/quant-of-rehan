<?xml version="1.0" encoding="utf-8"?>
<!--
    The magnifier, drawn as two strokes and no fill.

    Owner order 2026-10-20 (second note): the search control was the owner's
    search.png, a solid yellow disc with the glass knocked out of it by the
    bitmap's own colour. Tinted gold by the ImageView, the disc and the glass
    merged into one yellow blob, which is what he reported. A vector cannot
    do that: the glass is a stroked circle (fillColor transparent) and the
    handle is a stroked line, so the tint only ever colours the ring and the
    handle and the glass stays see-through at every screen density.

    The stroke is 2.2/24 of the box, the weight the PNG's ink measured, so the
    control keeps its size; the ImageView's own 8dp padding is unchanged.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:pathData="M3.5,10.5 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.2"/>

    <path
        android:pathData="M15.6,15.6 L20.8,20.8"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="2.2"/>
</vector>
