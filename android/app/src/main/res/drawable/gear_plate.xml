<?xml version="1.0" encoding="utf-8"?>
<!-- The settings button's plate, closed state: the same plum and hairline
     edge the button has always worn, lifted out of gear_bg.xml so the
     ripple wrapper and the open state can share one definition. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/plum_panel_top"/>
    <stroke android:width="1dp" android:color="@color/bg_panel_edge"/>
    <corners android:radius="14dp"/>
</shape>
