<?xml version="1.0" encoding="utf-8"?>
<!-- The dropdown's state arrow (owner order 2026-10-23, 2.0.0): a small
     gold triangle. It points DOWN here (the pull-down cue while the menu
     is closed); MainActivity rotates the view 180 degrees while the menu
     is open, so one drawable serves both directions.

     v2.3.15 owner order 2026-10-27 ("the drop down icon is really small,
     I can't even see it"): the old path was 10x5 units inside a 24x24
     viewport drawn from a 14dp intrinsic - about 6x3dp of visible ink,
     which read as nothing on the phone. The path now fills half the
     viewport (12x8 units) and the intrinsic steps to 20dp, and the two
     arrow views in the layout carry the 20dp themselves, so the cue is
     plainly visible whatever a future drawable's own size says. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@color/gold"
        android:pathData="M6,8.5l6,8l6,-8z"/>
</vector>
