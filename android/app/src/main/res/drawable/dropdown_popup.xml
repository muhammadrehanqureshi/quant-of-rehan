<?xml version="1.0" encoding="utf-8"?>
<!-- Owner order 2026-10-23 ("drop down menus should also match with the
     app's UI"): the platform's own popup is a flat grey receipt that sat
     on the console like a foreign object. The popup is now the app's own
     panel: the same plum gradient the tiles plate themselves with, the
     same panel edge, and the same roundness, so an open menu reads as
     the console opening, not as another app's dialog. The rows carry
     their own air, so the shape's padding is only the popup's frame. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/plum_panel_top"
        android:endColor="@color/plum_panel_bottom"/>
    <stroke
        android:width="1dp"
        android:color="@color/bg_panel_edge"/>
    <corners android:radius="12dp"/>
</shape>
