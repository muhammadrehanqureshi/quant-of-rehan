<?xml version="1.0" encoding="utf-8"?>
<!-- Owner order 2026-11-05, sixth pass: the owner's new picture, path for
     path. One ledger on top, a stem that splits into two arms and two
     ledgers below, drawn in one ink so the nav's own tint recolors it with
     the worn theme and it stays crisp at any density.

     The three squares are rounded rectangles, each a closed stroke; the
     stem and the two arms are separate strokes that end inside the
     squares' own top and bottom edges, so the ink joins without a seam
     and no cap is ever drawn outside the outer outline. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="500dp"
    android:height="500dp"
    android:viewportWidth="500"
    android:viewportHeight="500">

    <!-- The top ledger. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M212,30 L288,30 A34,34 0 0 1 322,64 L322,130 A34,34 0 0 1 288,164 L212,164 A34,34 0 0 1 178,130 L178,64 A34,34 0 0 1 212,30 Z"
        android:strokeColor="#FF000000"
        android:strokeWidth="26"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>

    <!-- The stem: out of the top ledger's bottom edge. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M250,158 L250,214"
        android:strokeColor="#FF000000"
        android:strokeWidth="26"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>

    <!-- The left arm: out of the stem's foot, across, and down into the
         left ledger's top edge. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M250,214 C250,246 236,258 204,258 L162,258 C136,258 122,274 122,300 L122,330"
        android:strokeColor="#FF000000"
        android:strokeWidth="26"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>

    <!-- The right arm, the same shape mirrored. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M250,214 C250,246 264,258 296,258 L338,258 C364,258 378,274 378,300 L378,330"
        android:strokeColor="#FF000000"
        android:strokeWidth="26"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>

    <!-- The left ledger. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,318 L142,318 A30,30 0 0 1 172,348 L172,440 A30,30 0 0 1 142,470 L54,470 A30,30 0 0 1 24,440 L24,348 A30,30 0 0 1 54,318 Z"
        android:strokeColor="#FF000000"
        android:strokeWidth="26"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>

    <!-- The right ledger. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M358,318 L446,318 A30,30 0 0 1 476,348 L476,440 A30,30 0 0 1 446,470 L358,470 A30,30 0 0 1 328,440 L328,348 A30,30 0 0 1 358,318 Z"
        android:strokeColor="#FF000000"
        android:strokeWidth="26"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>
</vector>
