<?xml version="1.0" encoding="utf-8"?>
<!-- OFFLINE indicator: the same beacon as ONLINE, unlit and hollow, so the
     two states are one shape apart rather than two different symbols. The
     retired glyphs (a check and a cross) read as edits and, to a screen
     reader, as arithmetic. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="18dp"
    android:height="18dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- halo ring, muted -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,2.6 a9.4,9.4 0 1,0 0,18.8 a9.4,9.4 0 1,0 0,-18.8"
        android:strokeColor="#59C14A52"
        android:strokeWidth="1.3"/>

    <!-- hollow core: present, not lit -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,6.4 a5.6,5.6 0 1,0 0,11.2 a5.6,5.6 0 1,0 0,-11.2"
        android:strokeColor="#CCC14A52"
        android:strokeWidth="1.7"/>
</vector>
