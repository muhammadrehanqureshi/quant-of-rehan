    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The three ledgers. Each is one rounded box with a printed row. -->
    <path
        android:pathData="M8.2,1.6h9.4a1.7,1.7 0 0 1 1.7,1.7v1.4a1.7,1.7 0 0 1 -1.7,1.7h-9.4a1.7,1.7 0 0 1 -1.7,-1.7v-1.4a1.7,1.7 0 0 1 1.7,-1.7z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M8.2,9.6h9.4a1.7,1.7 0 0 1 1.7,1.7v1.4a1.7,1.7 0 0 1 -1.7,1.7h-9.4a1.7,1.7 0 0 1 -1.7,-1.7v-1.4a1.7,1.7 0 0 1 1.7,-1.7z"
        android:strokeColor="#FFFFFFFF"
