<?xml version="1.0" encoding="utf-8"?>
<!-- v2.2.5 (owner order 2026-10-24, fourth note, "drop down menus should
     also match with the app's current theme"): the dropped menu's own
     mosaic. One plate per theme, all five drawn from the same table
     (dropdown_popup.xml carries the app's own plum look and this family
     the other four themes), so an open menu reads as the theme the
     console is wearing, never the platform's grey. BLACK & WHITE plate:
     the theme's own panel ink, its rows carrying the same edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/theme_black_panel"/>
    <stroke
        android:width="1dp"
        android:color="@color/theme_black_accent"/>
    <corners android:radius="12dp"/>
</shape>
