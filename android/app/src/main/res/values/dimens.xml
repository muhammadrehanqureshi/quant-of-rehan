<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The status tile's spacing, one number (owner order 2026-10-14,
         eighth note). SYSTEM STATUS to ONLINE and ONLINE to KARACHI are the
         same air, so the tile's rhythm is declared here rather than in two
         margins that could drift apart. -->
    <dimen name="status_gap">10dp</dimen>

    <!-- The beacon to the word inside the badge: the 8dp the compound
         drawable used to carry as android:drawablePadding. -->
    <dimen name="status_dot_gap">8dp</dimen>

    <!-- The settings control's nudge from where the brand row anchors it
         (owner orders 2026-10-15, stacked): the second order moved the
         control 20% of its own 42dp box right and 5% up; today's order moves
         it a further 70% of that same box right and a further 15% up FROM
         where the shift already stood. Translation on a leaf view does not
         change layout, so the orders stack in place: 20 + 70 = 90% of the
         42dp box right (37.8dp), 5 + 15 = 20% of it up (8.4dp, a negative
         translation in Android's coordinates). Both are fractions of the
         control rather than screen pixels, so the shift is the same shape
         on any screen and at any font scale. The anchors themselves stay:
         the pair still holds beside the title, and this is the offset from
         there. -->
    <dimen name="settings_shift_x">37.8dp</dimen>
    <dimen name="settings_shift_y">-8.4dp</dimen>
</resources>
