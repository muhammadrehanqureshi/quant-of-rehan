    <!-- ============ status pill ============
         Owner order 2026-10-10: professional checkmark and cross glyphs in
         place of the round dot. The glyph is part of the resource text so the
         pill and its accessibility description can never drift apart. -->
    <string name="status_checking">"…  CHECKING"</string>
    <string name="status_online">"✓  ONLINE"</string>
    <string name="status_offline">"✗  OFFLINE"</string>
    <string name="cd_status_checking">System status: checking.</string>
    <string name="cd_status_online">System status: online. The market is open and the quant is running.</string>
    <string name="cd_status_offline">System status: offline. The market is closed, or the relay cannot be reached.</string>

    <!-- ============ scan cadence ============
         Owner order 2026-10-11, exact text: the main screen states the scan
         cadence. The 4 is the real interval, not decoration: it is
         config.TICK_INTERVAL_MINUTES = 4, which drives the Windows tick, the
         supervised scan loop and the slot guard. The scanning itself happens
         only inside the MARKET phase (09:32-15:30, Friday 09:17-16:30 with the
         midday break); this line states the cadence, and the pill above states
         whether the quant is online. -->
    <string name="scan_cadence">Quant is scanning the market every 4 minutes.</string>

    <!-- ============ session copy ============
         Owner order 2026-10-10: "PSX session closed" is retired. The relay's
         own market_state phase decides which of these the app shows, and the
         app never derives a session from its own clock (SO-8). -->
    <string name="market_closed_now">Market is closed now.</string>
    <string name="market_on_break">Market is on a break right now.</string>
    <!-- %1$s is the resume time reported by the relay, for example 14:32 -->
    <string name="market_break_resumes">Market is on a break right now (trading resumes %1$s PKT).</string>
    <!-- Shown only when the relay reports no phase at all. The app refuses to
         guess a session, so it says so instead of claiming the market is shut. -->
    <string name="market_status_unreported">Market status not reported by the relay yet.</string>

    <string name="market_waiting">KSE100  ·  loading</string>
