<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="QorPanel">
        <item name="android:background">@drawable/panel_bg</item>
        <item name="android:padding">14dp</item>
    </style>
    <style name="QorButton">
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:padding">10dp</item>
        <item name="android:textColor">@color/text_bright</item>
    </style>
    <style name="QorLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="QorBody">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_soft</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
</resources>
