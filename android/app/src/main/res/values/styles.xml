<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cards: subtle vertical plum gradient, hairline plum edge. -->
    <style name="QorPanel">
        <item name="android:background">@drawable/panel_bg</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="QorButton">
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/text_bright</item>
    </style>
    <style name="QorLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
    </style>
    <style name="QorBody">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_soft</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="QorDiamond">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:letterSpacing">0.6</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
