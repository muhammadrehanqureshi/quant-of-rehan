<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Type strategy (owner order 2026-10-12: "replace the rest of the fonts
         with LEMONMILK-BOLD & LEMONMILK-LIGHT wherever you think is
         necessary").

         Measured against the fonts' own cmaps before they were wired in, so
         the choice is a fact about the files rather than a guess:

         * LEMON MILK (free tier) maps every lowercase codepoint onto its
           uppercase glyph, so any text drawn in it renders as capitals. That
           is exactly right for labels, buttons, badges and the card's numbers.
           Owner order 2026-10-13 put the system status and the latest signal
           tiles in it end to end as well (the pill, the detail line and the
           signal list), which the owner ordered knowing it reads in capitals.
           The settings hint and the token field keep the system face: the hint
           is a paragraph, and a pasted token must render exactly as pasted.
         * LEMON MILK HAS U+2248 (the "about" mark the card uses for an
           estimated split), so the marked numbers need no special handling.
         * LEMON MILK HAS no U+25B2/U+25BC (the up and down arrows). The arrow
           ranges are therefore drawn with the system face by a span in
           MainActivity, which is why QorBody's family is deliberately left
           alone.
         * No bundled face has U+25C6 (the brand diamond) or U+2699, so
           QorDiamond keeps the system face and the settings control is an
           image (the owner's own settings.png) instead of a glyph. -->

    <!-- Cards: subtle vertical plum gradient, hairline plum edge. -->
    <style name="QorPanel">
        <item name="android:background">@drawable/panel_bg</item>
        <item name="android:padding">16dp</item>
    </style>
    <!-- The buttons are lines too, not headings: owner order 2026-10-22,
         every non-heading word on the console carries the body's one size,
         so the buttons left their own 12sp for it. -->
    <style name="QorButton">
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:fontFamily">@font/lemonmilk_bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/text_bright</item>
    </style>
    <!-- Owner order 2026-10-23 (v1.9.13): every heading shrinks 10% from
         its previous size, one factor on the one heading style. -->
    <style name="QorLabel">
        <item name="android:fontFamily">@font/lemonmilk_bold</item>
        <item name="android:textSize">15.944049sp</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
    </style>
    <!-- The settings paragraph and the token field: system face, by the type
         strategy above. The hint is a paragraph rather than a label, and a
         pasted token must render exactly as pasted. -->
    <style name="QorBody">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_soft</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <!-- Owner order 2026-10-22: every heading shares ONE size, so the tile
         names read as one system rather than at whatever each tile last wore.
         QorLabel is the one heading style the console uses. -->
    <style name="QorHeading" parent="QorLabel" />
    <!-- Owner order 2026-10-23 (v1.9.13): the app brand name is bigger
         than every other heading, so it stands as the name of the whole
         console rather than as one of the tile names, and it GREW 20% on
         its own previous size by the owner's word. -->
    <style name="QorBrandTitle" parent="QorLabel">
        <item name="android:textSize">24.44754sp</item>
    </style>
    <!-- The owner's face for short-form text: the market card's values
         (numbers, tickers, money) and, after the order of 2026-10-13, the
         system status and latest signal tiles' own lines. All of it is
         capitals by nature, so LEMON MILK Light fits and reads as one system
         with the labels above them. -->
    <style name="QorValue" parent="QorBody">
        <item name="android:fontFamily">@font/lemonmilk_light</item>
    </style>
    <!-- The console's last sentence. Owner order 2026-10-21 (15:15): one size
         for every line that is not a bold heading, so the caption keeps the
         body's 13sp and only its face marks it as the footer. -->
    <style name="QorCaption" parent="QorBody">
        <item name="android:fontFamily">@font/lemonmilk_light</item>
        <item name="android:textSize">13sp</item>
    </style>
    <!-- The brand diamond. No fontFamily on purpose: U+25C6 exists in none of
         the bundled faces, so a custom family here would draw a box. -->
    <style name="QorDiamond">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:letterSpacing">0.6</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
