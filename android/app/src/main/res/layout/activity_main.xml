<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="24dp">

        <!-- ══════════ header: brand centered, gear floats right ══════════ -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="vertical">

                <!-- The brand face (owner order 2026-10-12): Bonskin, the
                     owner's own script signature face, at 30sp.
                     No letterSpacing and no textStyle="bold": tracking a
                     script face breaks its joins, and Android would fake a
                     bold from a face that already carries one weight.
                     30sp is measured, not guessed: the string advances
                     6.677 em, so 200dp on the narrowest phone this app
                     supports, against about 320dp of content width.

                     includeFontPadding stays at its default (true) for the
                     same measured reason: Bonskin's ink for this exact string
                     reaches 779/1000 em while its TYPOGRAPHIC ascender is only
                     730/1000, so the tighter box would shave the top of the
                     capital Q. The default box uses the font's hhea metrics
                     (1006 / -288), which contain the ink with room to spare. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/bonskin"
                    android:gravity="center"
                    android:paddingBottom="2dp"
                    android:shadowColor="@color/crimson_logo"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:text="@string/app_name"
                    android:textColor="@color/gold_bright"
                    android:textSize="30sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/lemonmilk_light"
                    android:gravity="center"
                    android:letterSpacing="0.18"
                    android:text="@string/tagline"
                    android:textColor="@color/teal"
                    android:textSize="10sp"/>
            </LinearLayout>

            <!-- neutral plum in every state; gold ring only while the
                 settings panel is open.

                 Owner order 2026-10-12: the U+2699 text glyph is gone. The
                 control is the vector gear (drawable/ic_gear) on a masked
                 ripple, so it is the same drawn shape at every density, gives
                 press feedback, and cannot fall back to a missing-glyph box.
                 MainActivity swaps only the plate (gear_bg <-> gear_bg_open). -->
            <ImageView
                android:id="@+id/btn_settings"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/gear_bg"
                android:contentDescription="@string/cd_settings"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_gear"/>
        </RelativeLayout>

        <!-- brand rule: line, diamond, line (from the logo frame). Defined
             once in layout/qor_rule.xml and included at each of the three
             places it closes: the header, the signal card and the market
             card, so "the same as the two above" is true by construction. -->
        <include
            layout="@layout/qor_rule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>

        <!-- ══════════ system status card ══════════ -->
        <LinearLayout style="@style/QorPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView style="@style/QorLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/label_system"/>

            <!-- Owner order 2026-10-11: the state is a status light plus the
                 word, in one badge. The indicator is a vector drawable and
                 MainActivity swaps it with the state, so ONLINE and OFFLINE
                 are the same shape lit and unlit rather than two glyphs. -->
            <TextView
                android:id="@+id/status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:drawableStart="@drawable/ic_status_checking"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:letterSpacing="0.08"
                android:minHeight="34dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:accessibilityLiveRegion="polite"
                android:contentDescription="@string/cd_status_checking"
                android:text="@string/status_checking"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/status_detail"
                style="@style/QorBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"/>

        </LinearLayout>

        <!-- ══════════ latest signal card ══════════ -->
        <LinearLayout style="@style/QorPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView style="@style/QorLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/label_signal"/>

            <TextView
                android:id="@+id/signal_list"
                style="@style/QorBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/no_signals"/>
        </LinearLayout>

        <!-- brand rule after the latest signal: the same include, closing the
             card section like the logo frame -->
        <include
            layout="@layout/qor_rule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"/>

        <!-- ══════════ settings (hidden until the gear is tapped) ══════════ -->
        <LinearLayout
            android:id="@+id/settings_panel"
            style="@style/QorPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView style="@style/QorLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_settings"/>

            <TextView style="@style/QorBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings_hint"/>

            <EditText
                android:id="@+id/token_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/field_bg"
                android:hint="@string/token_hint"
                android:inputType="textVisiblePassword"
                android:padding="12dp"
                android:textColor="@color/text_bright"
                android:textColorHint="#FF6E5A78"
                android:textSize="12sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_save"
                    style="@style/QorButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_save"/>

                <Button
                    android:id="@+id/btn_open"
                    style="@style/QorButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:text="@string/btn_relay"/>
            </LinearLayout>

            <Button
                android:id="@+id/btn_arm"
                style="@style/QorButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_arm"/>
        </LinearLayout>

        <!-- ══════════ market card ══════════
             Third box, same shape as the two above: KSE100 points and
             percentage plus the day's top three KMIALL stocks by volume,
             rebuilt by the relay every five minutes.

             Owner order 2026-10-12: the card carries no "MARKET NOW" label
             any more. The index line and the ranking state what the card is
             by themselves, and the label was the last piece of chrome the
             owner asked to have removed. -->
        <LinearLayout style="@style/QorPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/market_index"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/lemonmilk_bold"
                android:gravity="center"
                android:text="@string/market_waiting"
                android:textColor="@color/text_bright"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <!-- The card's values carry LEMON MILK Light (QorValue): tickers,
                 money and counts are capitals by nature, so the free face's
                 uppercase-only mapping costs nothing here. The up and down
                 arrows are the exception and are drawn with the system face
                 by a span in MainActivity, because no bundled face has
                 U+25B2/U+25BC. -->
            <TextView
                android:id="@+id/market_leaders"
                style="@style/QorValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/market_leaders_waiting"/>

            <TextView
                android:id="@+id/market_foot"
                style="@style/QorCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"/>

            <!-- Owner order 2026-10-12 (third note): the diamond in the middle
                 with a line either side, at the bottom of the third tile,
                 identical to the two above because it IS the same layout. -->
            <include
                layout="@layout/qor_rule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"/>
        </LinearLayout>


        <!-- Owner order 2026-10-12: the pinned bottom cadence and the footer
             rule are gone. The cadence sentence now sits in the market card
             itself, where the volume ranking can be read with it, so the
             interface ends at the card. -->
    </LinearLayout>
</ScrollView>
