<?xml version="1.0" encoding="utf-8"?>
<!-- Owner order 2026-10-23 (v2.2.1, "why do I need 1 second watch window?
     if it's not needed anymore then remove it"): the watch window's
     plumbing left the manifest with its code. The boot receiver (it re-armed
     the alarm loop after a restart) and the two permissions it served
     (RECEIVE_BOOT_COMPLETED, REQUEST_IGNORE_BATTERY_OPTIMIZATIONS) are gone;
     the quant already scans every second in the cloud and the relay
     delivers the feed and signals from there, so the handset schedules
     nothing of its own. versionCode 60 / versionName 2.2.2 belong to the
     owner order 2026-10-24; the versions are set here, in the source
     tree, and the android-apk workflow reads and asserts them - it never
     bumps them on its own. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="pk.quantofrehan"
    android:versionCode="60"
    android:versionName="2.2.2">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="30"/>

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:allowBackup="false">

        <activity android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <service android:name=".StatusService"
            android:exported="false"/>
    </application>
</manifest>
