<!-- Owner order 2026-10-23 (v2.2.1, "why do I need 1 second watch window?
     if it's not needed anymore then remove it"): the watch window's
     plumbing left the manifest with its code. The boot receiver (it re-armed
     the alarm loop after a restart) and the two permissions it served
     (RECEIVE_BOOT_COMPLETED, REQUEST_IGNORE_BATTERY_OPTIMIZATIONS) are gone;
     the quant already scans every second in the cloud and the relay
     delivers the feed and signals from there, so the handset schedules
     nothing of its own. versionCode 61 / versionName 2.2.3 belong to the
     owner order 2026-10-24 (the equal-gap menu bar, the photo sun, the
     left-turn gear, the themes tile of its own and the search page's
     diamond rule and de-cluttering); the versions are set here, in the
     source tree, and the android-apk workflow reads and asserts them -
     it never bumps them on its own.

     versionCode 62 / versionName 2.2.4 belong to the owner order
     2026-10-24, third pass: the revolving sun, the refined filaments,
     the diamond rule between the search tile and the volume tile, the
     one-icon highlight law, and the version line moved under the
     themes tile's closing diamond in his own wording.

     versionCode 63 / versionName 2.2.5 belong to the owner order
     2026-10-24, fourth pass: the sun actually TURNS (the platform's
     degrees-and-radians bug found and fixed, fire steady, no flicker),
     the orbiting lines breathe (each shorter then longer, one breath
     period, no two in step), the version line can no longer fuse
     (APP VERSION IS 2.2.5), the dropdowns and search boxes follow the
     app's current theme and stay seated in their tiles, and the
     volume tile's menu carries the scanner's own first entry - the
     three fast risers, capped scrips out, each with its buyers,
     sellers, total volume, price and percentage. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="pk.quantofrehan"
    android:versionCode="63"
    android:versionName="2.2.5">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="30"/>

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:allowBackup="false">

        <activity android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <service android:name=".StatusService"
            android:exported="false"/>
    </application>
</manifest>
