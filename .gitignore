# --- Secrets: never commit ---
credentials*.txt
*credentials*
*.local.json
*.env
.env*
secrets*
data/secrets/
!**/.gitkeep

# --- Local data / research artifacts (root-anchored: never ignore src/data/) ---
/data/
/logs/
*.sqlite
*.sqlite3
*.db
*.parquet
*.csv.gz
backtests/output/

# --- Build drop / scratch: a certificate readout or an APK is never a
#     tracked artifact, and a scratch patch script is never either. The
#     drop goes to the OneDrive desktop folder, not the repository. ---
/build_artifacts/

# --- Legacy local secrets: a token file is never a tracked artifact ---
legacy/eod/data/
legacy/sentinel/data/
*_token.txt

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- OS / editor ---
Thumbs.db
.DS_Store
*.lnk
desktop.ini
.freebuff/

# --- Android build outputs ---
android/app/build/

# --- Web app: dependencies and build output are never tracked ---
web/node_modules/
web/dist/

# --- Local tool output (worker_check.py harness) ---
/tmp/
